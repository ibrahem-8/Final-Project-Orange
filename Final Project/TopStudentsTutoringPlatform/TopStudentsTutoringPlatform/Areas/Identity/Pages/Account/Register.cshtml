@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6">
                    <div class="auth-form-panel">
                        <span class="hero-badge">🚀 Join TopStudents</span>

                        <h1 class="auth-title">
                            Create your account and start learning smarter.
                        </h1>

                        <p class="auth-subtitle">
                            Register as a student to book sessions, or as a tutor to share your academic knowledge.
                        </p>

                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.FullName"
                                       class="form-control"
                                       autocomplete="name"
                                       aria-required="true"
                                       placeholder="Full Name" />
                                <label asp-for="Input.FullName">Full Name</label>
                                <span asp-validation-for="Input.FullName" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <select asp-for="Input.Role" class="form-select" aria-required="true">
                                    <option value="">Select account type</option>
                                    <option value="Student">Student</option>
                                    <option value="Tutor">Tutor</option>
                                </select>
                                <label asp-for="Input.Role">Account Type</label>
                                <span asp-validation-for="Input.Role" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />
                                <label asp-for="Input.Email">Email</label>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="password" />
                                <label asp-for="Input.Password">Password</label>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-4">
                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       aria-required="true"
                                       placeholder="password" />
                                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="upload-zone mb-3">
                                <div class="upload-icon">🖼️</div>
                                <div class="flex-grow-1">
                                    <label asp-for="Input.ProfileImageFile" class="form-label fw-bold">Profile Image Optional</label>
                                    <input asp-for="Input.ProfileImageFile"
                                           type="file"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp" />
                                    <span asp-validation-for="Input.ProfileImageFile" class="text-danger"></span>
                                    <small class="text-muted">
                                        Upload a profile image. If you skip it, your initials will be shown instead.
                                    </small>
                                </div>
                            </div>

                            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">
                                Create Account
                            </button>

                            <p class="auth-switch-text">
                                Already have an account?
                                <a asp-area="Identity" asp-page="/Account/Login">
                                    Login here
                                </a>
                            </p>
                        </form>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="auth-info-panel">
                        <div class="auth-glow"></div>

                        <div class="auth-info-content">
                            <h2>Choose how you want to use the platform.</h2>
                            <p>
                                TopStudents supports both learners and high-achieving students who want to teach.
                            </p>

                            <div class="auth-role-card">
                                <div class="auth-role-icon">🎓</div>
                                <div>
                                    <h5>Student</h5>
                                    <p>
                                        Search approved top student tutors, view academic profiles,
                                        book sessions, pay securely, join meetings, and submit reviews.
                                    </p>
                                </div>
                            </div>

                            <div class="auth-role-card">
                                <div class="auth-role-icon">👨‍🏫</div>
                                <div>
                                    <h5>Tutor</h5>
                                    <p>
                                        Create your tutor profile, upload your transcript,
                                        add subjects and grades, manage availability, and receive bookings.
                                    </p>
                                </div>
                            </div>

                            <div class="auth-mini-stats">
                                <div>
                                    <strong>Verified</strong>
                                    <span>Tutor approval</span>
                                </div>

                                <div>
                                    <strong>Stripe</strong>
                                    <span>Secure payment</span>
                                </div>

                                <div>
                                    <strong>Online</strong>
                                    <span>Meeting links</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}