@using Microsoft.AspNetCore.Identity
@using TopStudentsTutoringPlatform.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser?.FullName ?? UserManager.GetUserName(User);

        <li class="nav-item">
            <a class="nav-link profile-nav-link" asp-controller="Profile" asp-action="Index" title="My Profile">
                @if (!string.IsNullOrWhiteSpace(currentUser?.ProfileImageUrl))
                {
                    <img src="@currentUser.ProfileImageUrl"
                         alt="Profile Image"
                         class="profile-nav-image" />
                }
                else
                {
                    <span class="profile-nav-icon">👤</span>
                }

                <span>@displayName</span>
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link border-0">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>